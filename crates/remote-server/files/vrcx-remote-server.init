#!/bin/sh /etc/rc.common
# vrcx-0-remote-server — procd service for OpenWrt
#
# Install as /etc/init.d/vrcx-remote-server, then:
#   chmod +x /etc/init.d/vrcx-remote-server
#   /etc/init.d/vrcx-remote-server enable
#   /etc/init.d/vrcx-remote-server start

START=99
STOP=10
USE_PROCD=1

PROG=/opt/vrcx-0/bin/vrcx-0-remote-server
# Must live off-flash. The overlay on most routers is ~150 MB and will not
# survive years of SQLite growth. Point this at the mounted external disk.
DATA_DIR=/mnt/vrcx-data/VRCX-0
BIND=0.0.0.0:8790
# Admission control. Required before any tenant can be claimed beyond the first,
# so a server that is reachable from anywhere at all must set it — otherwise the
# first caller to reach /v1/tenants claims this server. Generate one with
# `head -c 18 /dev/urandom | base64` and keep it out of version control.
# VRCX_SERVER_INVITE=
# Migration aid, not a runtime credential: pass the shared token an existing
# deployment's clients already hold and they keep working across the upgrade.
# Ignored once a tenant exists. Per-tenant tokens are issued by
# POST /v1/tenants and are never reused.
# VRCX_SERVER_TOKEN=

start_service() {
    # Refusing to start protects you from a subtle failure: if the disk did
    # not mount yet, the server would otherwise quietly create a fresh empty
    # database on flash and fill it up.
    if [ ! -d "$DATA_DIR" ]; then
        logger -t vrcx-remote-server "data dir $DATA_DIR is missing; is the external disk mounted?"
        return 1
    fi

    if [ ! -x "$PROG" ]; then
        logger -t vrcx-remote-server "refusing to start: $PROG is missing or not executable"
        return 1
    fi

    procd_open_instance
    procd_set_param command "$PROG" --bind "$BIND" --data-dir "$DATA_DIR"
    # respawn <threshold> <timeout> <retry>: 5 failures within an hour before
    # giving up. A short window would be wrong here — a brief VRChat outage
    # would burn all retries and leave the server permanently dead, unseen,
    # because nobody is watching a router.
    procd_set_param respawn 3600 5 5
    procd_set_param stdout 1
    procd_set_param stderr 1
    procd_set_param pidfile /var/run/vrcx-remote-server.pid
    procd_set_param limits core="0 0"
    if [ -n "$VRCX_SERVER_INVITE" ]; then
        procd_set_param env VRCX_SERVER_INVITE="$VRCX_SERVER_INVITE"
    fi
    if [ -n "$VRCX_SERVER_TOKEN" ]; then
        procd_set_param env VRCX_SERVER_TOKEN="$VRCX_SERVER_TOKEN"
    fi
    procd_close_instance
}

stop_service() {
    # Graceful shutdown lets the runtime close the pipeline socket and flush
    # the write-ahead log instead of leaving SQLite to recover.
    logger -t vrcx-remote-server "stopping"
}

service_triggers() {
    procd_add_reload_trigger vrcx-remote-server
}
